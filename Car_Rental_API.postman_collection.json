                {
                    "name": "3.3 Create Rental Booking",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "var startDate = new Date();",
                                    "startDate.setDate(startDate.getDate() + 1);",
                                    "var endDate = new Date();",
                                    "endDate.setDate(endDate.getDate() + 3);",
                                    "",
                                    "pm.variables.set('startDate', startDate.toISOString().split('T')[0]);",
                                    "pm.variables.set('endDate', endDate.toISOString().split('T')[0]);"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Rental created', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.data && jsonData.data.id) {",
                                    "    pm.collectionVariables.set('rentalId', jsonData.data.id);",
                                    "}"
                                ],
                                "type": "text/javascript"
