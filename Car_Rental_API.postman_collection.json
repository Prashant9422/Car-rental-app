{
    "info": {
        "_postman_id": "car-rental-api-collection",
        "name": "Car Rental API - Complete Test Suite",
        "description": "Comprehensive sequential test suite for the Car Rental API.\n\n## 🔄 Test Flow\nThis collection is designed to be run as a complete sequence using the Collection Runner.\n\n### 0. Prerequisites\n- Health Check to ensure API is up\n\n### 1. Admin Setup\n- Admin logs in\n- Creates a dedicated 'TEST-CAR'\n- Updates the car details (test update)\n\n### 2. User Journey\n- Registers a new random customer\n- Logs in\n- Updates profile details\n- Browses specifically for the 'TEST-CAR'\n- Creates a rental booking\n- Makes a payment\n- Checks rental history\n\n### 3. Completion & Verification\n- Customer returns the car\n- Admin verifies the rental was recorded\n- Admin verifies the payment was recorded\n- Admin lists all users\n\n### 4. Cleanup\n- Admin deletes the 'TEST-CAR' to keep the system clean",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:5000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        },
        {
            "key": "adminToken",
            "value": "",
            "type": "string"
        },
        {
            "key": "customerId",
            "value": "",
            "type": "string"
        },
        {
            "key": "carId",
            "value": "",
            "type": "string"
        },
        {
            "key": "rentalId",
            "value": "",
            "type": "string"
        },
        {
            "key": "paymentId",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "0. Prerequisites",
            "item": [
                {
                    "name": "0.1 Health Check",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('API is healthy', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/health",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "health"
                            ]
                        },
                        "description": "Ensure the API is running before starting tests."
                    }
                }
            ]
        },
