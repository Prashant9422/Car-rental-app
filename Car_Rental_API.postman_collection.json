                                    "    pm.collectionVariables.set('carId', jsonData.data.id);",
                                    "    console.log('Test Car ID saved:', jsonData.data.id);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "var randomSuffix = Math.floor(Math.random() * 10000);",
                                    "pm.variables.set('randomSuffix', randomSuffix);"
                                ],
                                "type": "text/javascript"
                            }
